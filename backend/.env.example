# Copia este archivo como .env y ajusta los valores (NUNCA subas el .env real a GitHub)
PORT=3000
# Cadena larga y aleatoria. Obligatoria en producción.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Ruta del archivo SQLite (en la nube, apunta a un disco persistente si lo hay)
DB_PATH=./data/petstyle.db
# Opcional: si no existe ningún administrador, se crea uno al arrancar con estos datos.
# Útil en la nube gratuita, donde el disco puede borrarse al reiniciar.
ADMIN_EMAIL=admin@petstyle.com
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador PetStyle
